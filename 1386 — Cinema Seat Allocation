Easy
class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, int> mp;

        for (auto &x : reservedSeats) {
            int row = x[0];
            int seat = x[1];

            mp[row] |= (1 << (seat - 1));
        }

        int ans = (n - mp.size()) * 2;

        for (auto &[row, mask] : mp) {

            // Seats 2-5
            bool left = !(mask & (1 << 1)) &&
                        !(mask & (1 << 2)) &&
                        !(mask & (1 << 3)) &&
                        !(mask & (1 << 4));

            // Seats 6-9
            bool right = !(mask & (1 << 5)) &&
                         !(mask & (1 << 6)) &&
                         !(mask & (1 << 7)) &&
                         !(mask & (1 << 8));

            // Seats 4-7
            bool middle = !(mask & (1 << 3)) &&
                          !(mask & (1 << 4)) &&
                          !(mask & (1 << 5)) &&
                          !(mask & (1 << 6));

            if (left && right)
                ans += 2;
            else if (left || middle || right)
                ans += 1;
        }

        return ans;
    }
};
