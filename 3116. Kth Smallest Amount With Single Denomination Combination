
class Solution {
public:
    long long gcd(long long a, long long b) {
        return b == 0 ? a : gcd(b, a % b);
    }

    long long lcm(long long a, long long b) {
        return a / gcd(a, b) * b;
    }

    long long findKthSmallest(vector<int>& coins, int k) {
        int n = coins.size();

        auto check = [&](long long x) {
            long long cnt = 0;

            for (int mask = 1; mask < (1 << n); mask++) {
                long long L = 1;
                int bits = 0;

                for (int i = 0; i < n; i++) {
                    if (mask & (1 << i)) {
                        bits++;
                        L = lcm(L, coins[i]);

                        if (L > x)
                            break;
                    }
                }

                if (L > x)
                    continue;

                long long cur = x / L;

                if (bits & 1)
                    cnt += cur;
                else
                    cnt -= cur;
            }

            return cnt >= k;
        };

        long long left = 1;
        long long right = 1LL * (*min_element(coins.begin(), coins.end())) * k;

        while (left < right) {
            long long mid = left + (right - left) / 2;

            if (check(mid))
                right = mid;
            else
                left = mid + 1;
        }

        return left;
    }
};
