Easy
class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> cnt(51, 0);

        for (int x : nums)
            cnt[x]++;

        // k = 1: each element itself is a subarray
        if (k == 1) {
            int ans = -1;

            for (int x : nums) {
                if (cnt[x] == 1)
                    ans = max(ans, x);
            }

            return ans;
        }

        // k = n: only one subarray exists
        if (k == n)
            return *max_element(nums.begin(), nums.end());

        // 1 < k < n:
        // only first and last elements can appear in exactly one
        // subarray of size k.
        int ans = -1;

        if (cnt[nums[0]] == 1)
            ans = max(ans, nums[0]);

        if (cnt[nums[n - 1]] == 1)
            ans = max(ans, nums[n - 1]);

        return ans;
    }
};
