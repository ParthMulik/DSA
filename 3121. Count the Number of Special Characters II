class Solution {
public:
    int numberOfSpecialChars(string word) {
        vector<int> first(128, -1);
        vector<int> last(128, -1);

        for (int i = 0; i < word.size(); i++) {
            int c = word[i];

            if (first[c] == -1)
                first[c] = i;

            last[c] = i;
        }

        int ans = 0;

        for (int i = 0; i < 26; i++) {
            char lower = 'a' + i;
            char upper = 'A' + i;

            if (last[lower] != -1 &&
                first[upper] != -1 &&
                last[lower] < first[upper]) {
                ans++;
            }
        }

        return ans;
    }
};
